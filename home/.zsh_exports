export PATH="$HOME/bin:/usr/local/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:/usr/local/go/bin:$HOME/go/bin"
export ZSH_TMUX_AUTOSTART=true
export ENABLE_LSP_TOOL=1
export CLAUDE_ENABLE_LSP_TOOL=1
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export QLTY_INSTALL="$HOME/.qlty"
export PATH="$QLTY_INSTALL/bin:$PATH"
export EDITOR=nano
# conda
#  .  ~/miniconda3/etc/profile.d/conda.sh
#  . /usr/local/anaconda/etc/profile.d/conda.sh
#  conda activate base
#  conda zsh completions
zstyle ':completion::complete:*' use-cache 1

# completions
zstyle ':completion:*' completer _expand _complete _ignored _correct _approximate
zstyle ':completion:*' matcher-list 'm:{[:lower:]}={[:upper:]} m:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*' 'm:{[:lower:]}={[:upper:]} r:|[._-]=** r:|=**' '' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}'
zstyle :compinstall filename "$HOME/.zshrc"

# export GTK_THEME=Arc-Dark
if [ -z "$SSH_AUTH_SOCK" ] && [ -n "$XDG_RUNTIME_DIR" ]; then
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

with-testcontainers-colima() {
  local sock="${HOME}/.colima/default/docker.sock"

  if (( $# == 0 )); then
    echo "Usage: with-testcontainers-colima <command> [args...]" >&2
    return 2
  fi

  if [[ ! -S "$sock" ]]; then
    echo "ERROR: Colima Docker socket not found: $sock" >&2
    return 1
  fi

  env \
    -u TESTCONTAINERS_HOST_OVERRIDE \
    -u TC_HOST \
    DOCKER_HOST="unix://${sock}" \
    TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock \
    "$@"
}

setup-testcontainers-colima() {
  local sock="${HOME}/.colima/default/docker.sock"

  if [[ ! -S "$sock" ]]; then
    echo "ERROR: Colima Docker socket not found: $sock" >&2
    return 1
  fi

  export DOCKER_HOST="unix://${sock}"
  export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
  unset TESTCONTAINERS_HOST_OVERRIDE
  unset TC_HOST
}

export LLMG_API_KEY=""
export PI_CACHE_RETENTION=long
